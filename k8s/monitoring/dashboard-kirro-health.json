{
  "title": "KIRRO — Health & Errors",
  "uid": "kirro-health",
  "tags": ["kirro", "voice", "loki"],
  "schemaVersion": 38,
  "editable": false,
  "id": null,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Calls started (1h)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({filename=~\"/var/log/containers/.+_kirro_kirro-voice-.+\"} |= \"voice session started\" [1h]))",
          "queryType": "instant",
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Calls ended (1h)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({filename=~\"/var/log/containers/.+_kirro_kirro-voice-.+\"} |= \"voice session ended\" [1h]))",
          "queryType": "instant",
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "stat",
      "title": "AgenticOrg turns (1h)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({filename=~\"/var/log/containers/.+_kirro_kirro-voice-.+\"} | json | message=\"agenticorg turn\" [1h]))",
          "queryType": "instant",
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Turn latency p95 (1h)",
      "description": "AgenticOrg reply latency, from every turn's latency_ms.",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "quantile_over_time(0.95, {filename=~\"/var/log/containers/.+_kirro_kirro-voice-.+\"} | json | message=\"agenticorg turn\" | unwrap latency_ms [1h])",
          "queryType": "instant",
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pipeline errors (1h)",
      "description": "Anything STT/LLM/TTS raised, as logged by the worker's session error handler.",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({filename=~\"/var/log/containers/.+_kirro_kirro-voice-.+\"} | json | message=\"pipeline error\" [1h]))",
          "queryType": "instant",
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Gnani TTS/STT errors (1h)",
      "description": "The vendor failures that produced dead air on air: 'We are facing technical difficulties'.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({filename=~\"/var/log/containers/.+_kirro_kirro-voice-.+\"} | json | stage=~\"tts_error|stt_error\" [1h]))",
          "queryType": "instant",
          "editorMode": "code"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Calls started / ended",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({filename=~\"/var/log/containers/.+_kirro_kirro-voice-.+\"} |= \"voice session started\" [5m]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "started"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({filename=~\"/var/log/containers/.+_kirro_kirro-voice-.+\"} |= \"voice session ended\" [5m]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "ended"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pipeline errors by stage",
      "description": "A spike here is what the caller hears as silence or choppy audio.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (stage) (count_over_time({filename=~\"/var/log/containers/.+_kirro_kirro-voice-.+\"} | json | message=\"pipeline error\" [5m]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "AgenticOrg turn latency (p50 / p95)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "fillOpacity": 0 } } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "quantile_over_time(0.5, {filename=~\"/var/log/containers/.+_kirro_kirro-voice-.+\"} | json | message=\"agenticorg turn\" | unwrap latency_ms [5m])",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "quantile_over_time(0.95, {filename=~\"/var/log/containers/.+_kirro_kirro-voice-.+\"} | json | message=\"agenticorg turn\" | unwrap latency_ms [5m])",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Turns per minute",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({filename=~\"/var/log/containers/.+_kirro_kirro-voice-.+\"} | json | message=\"agenticorg turn\" [1m]))",
          "queryType": "range",
          "editorMode": "code"
        }
      ]
    }
  ]
}
